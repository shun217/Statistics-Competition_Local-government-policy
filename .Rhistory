simulate_logistic <- function(n, b = NULL, A = NULL, p = 4) {
if (!is.null(b)) { p <- length(b) - 1 }
if (is.null(b)) {
b <- c(-2, runif(p, -5, 5))
}
if (is.null(A)) {
A <- matrix(runif(p*p), p, p) + 3 * diag(1:p)
}
x_orig <- matrix(runif(p * n), n, p)
x <- x_orig %*% A
b0 <- b[1]
b_vars <- b[-1]
z <- b0 + x %*% b_vars
mx<-pmax(0,z)
p<-exp(z-mx)/(exp(-mx)+exp(z-mx))
y <- as.numeric(runif(n) < p)
df <- data.frame(y = y, x)
model <- glm(y ~ ., data = df, family = binomial)
return(list(summary = summary(model), data = df))
}
